{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "vite/client"]
  },
  "include": ["vite.config.ts", "vitest.server.config.ts", "vitest.ai-pilot.config.ts", "playwright.config.ts", "playwright.server.config.ts", "eslint.config.js", "tests/e2e", "tests/e2e-server", "tests/db", "tests/server", "tests/ai-pilot"]
}
